{
  "name": "cyber-release",
  "version": "3.0.0",
  "private": true,
  "description": "赛博放生 · 单生物异步图文旅程（Agent 工程环境改造版）",
  "engines": {
    "node": ">=22"
  },
  "main": "serving/entrypoints/start.js",
  "scripts": {
    "start": "node --env-file-if-exists=data/.env serving/entrypoints/start.js",
    "dev": "node --env-file-if-exists=data/.env serving/entrypoints/start.js",
    "check": "node tooling/check.js",
    "check:fast": "node tooling/check.js --fast",
    "test": "node tooling/run-tests.js",
    "scenario": "node tests/scenarios/cli.js",
    "boundaries": "node tooling/boundary-check.js",
    "smoke:real": "node scripts/smoke-real.js",
    "db:backup": "node scripts/db-backup.js backup",
    "db:verify": "node scripts/db-backup.js verify"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "openai": "^6.44.0",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "topojson-client": "^3.1.0"
  }
