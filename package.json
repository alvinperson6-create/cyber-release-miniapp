{
  "name": "cyber-release",
  "version": "3.0.0",
  "private": true,
  "description": "赛博放生 · 单生物异步图文旅程（Agent 工程环境改造版）",
  "engines": {
    "node": ">=20 <27"
  },
  "main": "serving/entrypoints/start.js",
  "scripts": {
