# 赛博放生 · 服务配置示例
#
# 复制为 server/.env 后填入真实值。server/.env 已被 gitignore，不要提交。
# 所有开关都有默认值；只填必需项即可启动。

# 服务端口
PORT=3001

# ======== 文本模型（必需）========
# 没有它旅程无法开局（会如实提示，不伪造内容）
AI_PROVIDER=qianfan
AI_API_KEY=
AI_BASE_URL=https://qianfan.baidubce.com/v2
AI_MODEL=deepseek-v4-flash-0731

# provider 可选：openai | claude | doubao | qianfan

# ======== 配图（可选）========
# 未配置则不生成配图；信件文字照常送达
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# ======== JEV 语义判断（强烈建议）========
# 负责行动决策。缺失或不可用时，旅程会重试后如实暂停，
# **不会**用规则冒充生物的选择。
JEV_API_KEY=
JEV_ENABLED=1
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=30000

# JEV 走代理：JEV 按**请求出口 IP**做地域限制，从受限区域直连会拿到
# HTTP 451 "Typesafe is not available in your region"。
# Node 的 fetch 不读 macOS 系统代理，所以必须显式指定（macOS 常见端口见下）。
# 不填则直连；直连失败时的表现是 JEV 返回 451，旅程如实暂停。
# 查本机代理端口：scutil --proxy | grep -A2 HTTPSEnable
# JEV_PROXY=http://127.0.0.1:7897

# ======== 功能开关 ========
JOURNEY_ENABLED=1

# ======== 服务护栏（可选，均有默认值）========
# J_SIGNAL_DEADLINE_MS=21600000   # 信号补给截止（默认 6h）
# J_MAX_SILENCE_MS=129600000      # 最大静默，超时触发联系检查点（默认 36h）
# J_MIN_INTERVAL_MS=7200000       # 两次寄信最小间隔（默认 2h）
# J_QUIET_START=1                 # 安静时段起（本地小时）
# J_QUIET_END=7                   # 安静时段止
# J_MAX_EVENTS=12                 # 单程遭遇数上限
# J_MAX_MODEL_CALLS=60            # 单程模型调用预算（含 JEV 与识别）
# J_MAX_TASK_ATTEMPTS=4           # 任务重试上限，超限如实暂停
# J_IMAGE_BUDGET=1                # 单程配图预算，0 关闭
# J_LEASE_MS=300000               # 任务租约时长
# J_TICK_MS=10000                 # 调度间隔
# J_TIME_SCALE=1                  # 时长缩放（部署/演示用，非线上推进 API）

# JEV 处境识别的置信度阈值（见 docs/jev-validation.md 的校准记录）
# JEV_SITUATION_MIN_CONFIDENCE=0.45

# ======== 数据位置（可选）========
# 默认落在 server/data.db（历史位置，不随代码搬迁漂移）
# DB_PATH=/absolute/path/to/data.db
